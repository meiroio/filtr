# Filtr loads .env from the current working directory before starting.
# Generate the admin value with: openssl rand -hex 64
# FILTR_ADMIN_TOKEN=replace-with-128-hexadecimal-characters
# ANTHROPIC_API_KEY=your-provider-issued-key
# OPENAI_API_KEY=your-provider-issued-key-for-Luna-backup

# Optional primary preference; otherwise select the best configured provider.
FILTR_AI_PROVIDER=anthropic
# Optional: pin a native model ID instead of using the leaderboard.
# FILTR_AI_MODEL=anthropic/REPLACE_WITH_YOUR_MODEL_ID
# Optional effort for models supporting it; pinned models use provider defaults otherwise.
# FILTR_AI_REASONING=low
# Recheck expired entries automatically; default is one day. Zero disables caching/timer.
FILTR_AI_CACHE_TTL_SECS=86400
# Source builds after v0.1.1: forbid provider/leaderboard calls, including background refresh.
# Missing/expired reviews stay incomplete; cache-only uploads require complete cached coverage.
# FILTR_AI_CACHE_ONLY=true
# Provider attempt deadline and total budget across all AI batches.
FILTR_AI_TIMEOUT_SECS=300
# Additional HTTP 429/5xx retries per provider request (0..2); use 0 for a strict review budget.
# FILTR_AI_HTTP_RETRIES=2
FILTR_AI_REVIEW_TIMEOUT_SECS=900

# Default: use targeted filters and notify SRE about uncovered CVEs.
# Opt in to full blocking only for source-backed qualifying critical assessments.
FILTR_AUTO_BLOCK_CRITICAL=false

# Optional SRE automation webhook. Leave unset to disable notifications.
# Use HTTPS outside a trusted local network; give this endpoint its own token.
# FILTR_WEBHOOK_URL=https://sre.example.com/hooks/filtr
# FILTR_WEBHOOK_TOKEN=your-receiver-issued-secret
# FILTR_WEBHOOK_TIMEOUT_SECS=10

# Native development; Compose overrides this with its internal demo upstream.
FILTR_UPSTREAM=http://127.0.0.1:3000
# Exact socket-peer IPs trusted to overwrite forwarding metadata (no CIDR ranges).
# FILTR_TRUSTED_PROXIES=127.0.0.1
# Public hostnames without ports; omit to accept any syntactically valid Host.
# FILTR_ALLOWED_HOSTS=example.com,www.example.com
# Bounds wire body and, in source builds after v0.1.1, decoded body independently.
# FILTR_MAX_BODY_BYTES=1048576
# FILTR_MAX_IN_FLIGHT=128
# FILTR_TIMEOUT_SECS=10
