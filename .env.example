# Filtr loads .env from the current working directory before starting.
# Generate the admin value with: openssl rand -hex 64
# FILTR_ADMIN_TOKEN=replace-with-128-hexadecimal-characters
# ANTHROPIC_API_KEY=your-provider-issued-key
# OPENAI_API_KEY=your-provider-issued-key-for-Luna-backup

# Optional primary preference; otherwise select the best configured provider.
FILTR_AI_PROVIDER=anthropic
# Provider attempt deadline and total budget across all AI batches.
FILTR_AI_TIMEOUT_SECS=300
FILTR_AI_REVIEW_TIMEOUT_SECS=900
FILTR_OSV_TIMEOUT_SECS=600

# Native development; Compose overrides this with its internal demo upstream.
FILTR_UPSTREAM=http://127.0.0.1:3000
