ARG DISTRIBUTION=debian:bookworm-slim
FROM node:22-bookworm-slim AS node
FROM ${DISTRIBUTION}
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    nginx apache2 python3 ca-certificates openssl curl systemd \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && useradd --system --user-group --home-dir /srv/app --no-create-home --shell /usr/sbin/nologin app \
    && mkdir -p /srv/app \
    && cd /srv/app && printf '{"private":true}\n' > package.json \
    && npm install --ignore-scripts --omit=dev --no-audit --no-fund express@5.1.0
COPY tests/simple/systemctl.py /usr/bin/systemctl
RUN chmod 755 /usr/bin/systemctl
COPY tests/simple/node_scenario.py /scenario.py
CMD ["python3", "/scenario.py"]
